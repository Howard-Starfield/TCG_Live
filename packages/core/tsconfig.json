{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
