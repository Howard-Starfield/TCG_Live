# Copy values into your shell environment. This file is not loaded automatically.
PORT=3000
# DATABASE_URL=postgres://local_user:local_password@127.0.0.1:5432/tcg_live
TCG_DISCORD_APPLICATION_ID=
TCG_DISCORD_GUILD_ID=
TCG_DISCORD_CHANNEL_ID=
# Configure both to place each match card in its assigned voice-channel chat.
TCG_DISCORD_M1_CHANNEL_ID=
TCG_DISCORD_M2_CHANNEL_ID=
# Opt in only after both dedicated TCG Match voice rooms and bot permissions are ready.
TCG_DISCORD_PUBLIC_MATCH_ROOMS=0
TCG_DISCORD_PLAYER_A_ID=
TCG_DISCORD_PLAYER_B_ID=
TCG_DISCORD_PLAYER_C_ID=
TCG_DISCORD_PLAYER_D_ID=
# For signup-prepare/signup-run leave all four TCG_DISCORD_PLAYER_*_ID values blank.
TCG_DISCORD_ADMIN_ID=
TCG_DISCORD_TOKEN=
# Accepted fallback when TCG_DISCORD_TOKEN is unset or blank.
DISCORD_BOT_TOKEN=
# Local admin console (served on 127.0.0.1 at PORT by the bot). Accept only 0 or 1.
TCG_ADMIN_CONSOLE=0
# Lets a signed-in console session act as the configured admin. Only takes effect with TCG_ADMIN_CONSOLE=1.
TCG_ADMIN_COMMANDS=0
# Optional: location of the built web assets (defaults to apps/web/dist).
# TCG_ADMIN_WEB_DIST=
# Demo only (npm run admin:demo). The Discord runtime refuses to start while any of these is set.
# TCG_ADMIN_DEMO_MODE=interactive
# TCG_ADMIN_DEV_ORIGIN=http://localhost:5173
# TCG_ADMIN_LOGIN_TOKEN=
